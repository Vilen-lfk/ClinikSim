# Скопируйте в .env и подставьте свой ключ
OPENAI_API_KEY=sk-your-key-here
# Адрес OpenAI-совместимого API (оставьте пустым для официального OpenAI)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Запасные модели через запятую (работает только с OpenRouter)
OPENAI_FALLBACK_MODELS=
PATIENT_TEMPERATURE=0.7
EVALUATION_TEMPERATURE=0.2
DATABASE_URL=sqlite:///./simulator.db
CORS_ORIGINS=http://localhost:5173

# Сгенерируйте свой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=10080
TEACHER_INVITE_CODE=change-me-teacher-code

# true — пациент отвечает из базы фактов без ИИ (для отладки интерфейса)
MOCK_LLM=false
